# Credenciales de MySQL
DB_USER=CAMBIAR_ME                 # por ahora; en la Sesión B pasa a app
DB_PASSWORD=CAMBIAR_ME
MYSQL_DATABASE=CAMBIAR_ME
MYSQL_APP_USER=CAMBIAR_ME
MYSQL_APP_PASSWORD=CAMBIAR_ME

# URL JDBC del backend (opcional: si se omite se usa el default de application.yml)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/punto_venta?useSSL=false&allowPublicKeyRetrieval=true

# Puertos publicados en el host
PUERTO_MYSQL=CAMBIAR_ME
PUERTO_FRONTEND=CAMBIAR_ME
PUERTO_ADMINER=CAMBIAR_ME

# Credenciales de la pasarela simulada (VULNERABILIDAD: en texto plano)
PASARELA_API_KEY=CAMBIAR_ME
PASARELA_SECRET=CAMBIAR_ME

# Datos SMTP del administrador (VULNERABILIDAD: en texto plano)
SMTP_USER=CAMBIAR_ME
SMTP_PASSWORD=CAMBIAR_ME

JWT_SECRET=CAMBIAR_ME
FACTURACION_API_TOKEN=CAMBIAR_ME